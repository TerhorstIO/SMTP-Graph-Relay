{
  "name": "smtp-graph-relay",
  "author": "Bitcircuit",
  "license": "ISC",
  "version": "2.0.0",
  "description": "SMTP to Graph API relay server",
  "main": "dist/index.js",
  "bin": "dist/index.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "npm run build && node dist/index.js",
    "build": "tsc",
    "package": "node scripts/package-sea.js"
  },
  "keywords": [
    "smtp",
    "relay",
    "graph-api"
  ],
  "dependencies": {
    "@azure/identity": "^3.1.3",
    "@microsoft/microsoft-graph-client": "^3.0.5",
    "dotenv": "^16.0.3",
    "express": "^4.21.2",
    "ip-range-check": "^0.2.0",
    "mailparser": "^3.6.4",
    "multer": "^2.4.0",
    "selfsigned": "^2.4.1",
    "smtp-server": "^3.11.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/mailparser": "^3.4.0",
    "@types/node": "^22.15.3",
    "@types/smtp-server": "^3.5.10",
    "esbuild": "^0.25.5",
    "postject": "^1.0.0-alpha.6",
    "typescript": "^5.8.3"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
